# Public placeholders only. Lambda receives these through Terraform, not dotenv.
AWS_REGION=us-east-1
REMINDERS_TABLE=example-production-reminders
OWNER_STATE_TABLE=example-production-owner-state
IMAGE_JOBS_TABLE=example-production-image-jobs
IMAGES_BUCKET=example-production-images
EXPECTED_API_ID=example123
EXPECTED_API_STAGE=$default
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE
COGNITO_CLIENT_ID=example-public-client-id
ALLOWED_SOURCE_IPS=[]
MAX_JSON_BYTES=2097152
MAX_THUMBNAIL_BYTES=1048576
MAX_OWNER_ITEMS=1000
MAX_OWNER_IMAGE_BYTES=134217728
OWNER_REQUESTS_PER_MINUTE=120
# No access keys, client secrets, tokens, private mappings or real data here.
