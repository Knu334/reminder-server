+    @ParameterizedTest
+    @ValueSource(strings = {"client-id", "client-pool", "pool"})
+    void deletionDuringRefreshLeavesNoPersistedGrants(String resource) throws Exception {
+        StorageFactory first = factory("persistent");
+        LambdaService lambda = mock(LambdaService.class);
+        service = new CognitoService(first, configuration(), new RegionResolver("us-east-1", "000000000000"),
+                lambda, null, mock(SesService.class), mock(SnsService.class), clock, null);
+        initializeResources();
+        String original = token(List.of("openid"));
+        CountDownLatch inTrigger = new CountDownLatch(1);
+        CountDownLatch releaseTrigger = new CountDownLatch(1);
+        pool.setLambdaConfig(Map.of("PreTokenGeneration", "synthetic-pre-token"));
+        when(lambda.invoke(anyString(), eq("synthetic-pre-token"), any(byte[].class), any())).thenAnswer(call -> {
+            inTrigger.countDown();
+            assertTrue(releaseTrigger.await(10, TimeUnit.SECONDS));
+            return new InvokeResult(200, null, call.getArgument(2, byte[].class), null, "synthetic-request");
+        });
+        try (ExecutorService executor = Executors.newSingleThreadExecutor()) {
+            Future<?> refreshing = executor.submit(() -> {
+                try {
+                    refresh(original);
+                } catch (AwsException error) {
+                    assertEquals("NotAuthorizedException", error.getErrorCode());
+                }
+            });
+            assertTrue(inTrigger.await(10, TimeUnit.SECONDS));
+            FutureTask<Void> deletion = new FutureTask<>(() -> {
+                switch (resource) {
+                    case "client-id" -> service.deleteUserPoolClient(client.getClientId());
+                    case "client-pool" -> service.deleteUserPoolClient(pool.getId(), client.getClientId());
+                    case "pool" -> service.deleteUserPool(pool.getId());
+                    default -> throw new AssertionError(resource);
+                }
+                return null;
+            });
+            Thread deleting = Thread.ofPlatform().unstarted(deletion);
+            deleting.start();
+            try {
+                if ("pool".equals(resource)) {
+                    long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(10);
+                    while (deleting.getState() != Thread.State.BLOCKED && deleting.isAlive()
+                            && System.nanoTime() < deadline) {
+                        Thread.onSpinWait();
+                    }
+                    assertEquals(Thread.State.BLOCKED, deleting.getState());
+                } else {
+                    deleting.join(10_000);
+                    assertFalse(deleting.isAlive());
+                }
+            } finally {
+                releaseTrigger.countDown();
+            }
+            refreshing.get(10, TimeUnit.SECONDS);
+            deleting.join(10_000);
+            assertFalse(deleting.isAlive());
+            deletion.get(10, TimeUnit.SECONDS);
+        } finally {
+            releaseTrigger.countDown();
+            first.shutdownAll();
+        }
+        StorageFactory restarted = factory("persistent");
+        try {
+            persistentService(restarted);
+            assertTrue(refreshStore(restarted).keys().isEmpty(), "Deletion must remove every persisted descendant");
+        } finally {
+            restarted.shutdownAll();
+        }
+    }
