+    private Response oauth(String token, String clientId, String secret, String domainPool) {
+        MultivaluedHashMap<String, String> form = new MultivaluedHashMap<>();
+        form.putSingle("grant_type", "refresh_token");
+        form.putSingle("client_id", clientId);
+        if (token != null) {
+            form.putSingle("refresh_token", token);
+        }
+        if (secret != null) {
+            form.putSingle("client_secret", secret);
+        }
+        ContainerRequestContext context = mock(ContainerRequestContext.class);
+        when(context.getProperty(CognitoCustomDomainFilter.POOL_PROPERTY)).thenReturn(domainPool);
+        return controller.token(null, context, form);
+    }
