+package io.github.hectorvent.floci.services.cognito.model;
+
+import io.quarkus.runtime.annotations.RegisterForReflection;
+
+import java.util.List;
+
+/** Persisted refresh grant and its immutable rotation retry deadline. Times are epoch milliseconds. */
+@RegisterForReflection
+public record CognitoRefreshToken(String tokenId, String userPoolId, String username, String clientId,
+                                  String familyId, long expiresAt, List<String> scopes, boolean hosted,
+                                  Long retryUntil) {
+    public CognitoRefreshToken consumed(long deadline) {
+        return new CognitoRefreshToken(tokenId, userPoolId, username, clientId, familyId, expiresAt, scopes,
+                hosted, deadline);
+    }
+}
