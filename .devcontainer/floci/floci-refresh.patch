+
+/**
+ * Requests that reach an HTTP API through the virtual host ({@code {apiId}.execute-api.*}) go
+ * through {@link ApiGatewayExecuteApiHostFilter}, which rewrites the request URI. RESTEasy Reactive
+ * then keeps the path decoded once, so the raw path has to be taken from the original request.
+ * The unit tests build the event from a mocked UriInfo and the integration tests use path-style
+ * URLs, so neither goes through the filter plus controller path covered here.
+ */
+@QuarkusTest
+class ApiGatewayExecuteApiHostEncodedPathIntegrationTest {
+
+    private static final ObjectMapper MAPPER = new ObjectMapper();
+    private static final String FUNCTION = "host-encoded-path";
+
+    @InjectMock
+    LambdaService lambdaService;
+
+    private String apiId;
+
+    @BeforeEach
+    void createApiWithLambdaRoute() {
+        apiId = given()
+                .contentType(ContentType.JSON)
+                .body("""
+                        {"name":"host-encoded-path","protocolType":"HTTP"}
+                        """)
+                .when().post("/v2/apis")
+                .then()
+                .statusCode(201)
+                .body("apiId", notNullValue())
+                .extract().path("apiId");
+
+        for (String stageName : new String[] {"$default", "dev"}) {
+            given()
+                    .contentType(ContentType.JSON)
+                    .body("""
+                            {"stageName":"%s","autoDeploy":true}
+                            """.formatted(stageName))
+                    .when().post("/v2/apis/" + apiId + "/stages")
+                    .then()
+                    .statusCode(201);
+        }
+
+        String integrationId = given()
+                .contentType(ContentType.JSON)
+                .body("""
+                        {
+                          "integrationType":"AWS_PROXY",
+                          "integrationUri":"arn:aws:lambda:us-east-1:000000000000:function:%s/invocations",
+                          "integrationMethod":"POST",
+                          "payloadFormatVersion":"2.0"
+                        }
+                        """.formatted(FUNCTION))
+                .when().post("/v2/apis/" + apiId + "/integrations")
+                .then()
+                .statusCode(201)
+                .extract().path("integrationId");
+
+        given()
+                .contentType(ContentType.JSON)
+                .body("""
+                        {"routeKey":"GET /v2/reminders/{id}","target":"integrations/%s"}
+                        """.formatted(integrationId))
+                .when().post("/v2/apis/" + apiId + "/routes")
+                .then()
+                .statusCode(201);
+
+        when(lambdaService.invoke(anyString(), eq(FUNCTION), any(byte[].class), eq(InvocationType.RequestResponse)))
+                .thenReturn(new InvokeResult(200, null,
+                        "{\"statusCode\":200,\"body\":\"ok\"}".getBytes(StandardCharsets.UTF_8), null, "req-1"));
+    }
+
+    @AfterEach
+    void deleteApi() {
+        if (apiId != null) {
+            given().when().delete("/v2/apis/" + apiId).then().statusCode(204);
+        }
+    }
+
+    @ParameterizedTest
+    @CsvSource({
+            "100%25,100%",
+            "a%2Fb,a/b",
+            "%252F,%2F"
+    })
+    void hostRoutedDefaultStageKeepsRawPathAndDecodesPathParametersOnce(String rawId, String decodedId)
+            throws Exception {
+        given()
+                .urlEncodingEnabled(false)
+                .header("Host", apiId + ".execute-api.localhost.floci.io:4566")
+                .when().get("/v2/reminders/" + rawId)
+                .then()
+                .statusCode(200)
+                .body(equalTo("ok"));
+
+        assertInvokedWith("/v2/reminders/" + rawId, decodedId);
+    }
+
+    @Test
+    void hostRoutedExplicitStageKeepsRawPathAfterTheStage() throws Exception {
+        given()
+                .urlEncodingEnabled(false)
+                .header("Host", apiId + ".execute-api.localhost.floci.io:4566")
+                .when().get("/dev/v2/reminders/a%2Fb")
+                .then()
+                .statusCode(200)
+                .body(equalTo("ok"));
+
+        assertInvokedWith("/v2/reminders/a%2Fb", "a/b");
+    }
+
+    private void assertInvokedWith(String expectedRawPath, String expectedId) throws Exception {
+        ArgumentCaptor<byte[]> payload = ArgumentCaptor.forClass(byte[].class);
+        verify(lambdaService).invoke(anyString(), eq(FUNCTION), payload.capture(),
+                eq(InvocationType.RequestResponse));
+        JsonNode event = MAPPER.readTree(payload.getValue());
+        assertEquals("GET /v2/reminders/{id}", event.path("routeKey").asText());
+        assertEquals(expectedRawPath, event.path("rawPath").asText());
+        assertEquals(expectedId, event.path("pathParameters").path("id").asText());
+    }
+}
