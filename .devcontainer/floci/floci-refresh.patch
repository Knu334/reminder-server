+package io.github.hectorvent.floci.services.apigatewayv2;
+
+import io.github.hectorvent.floci.services.apigatewayv2.model.Route;
+import io.quarkus.test.junit.QuarkusTest;
+import jakarta.inject.Inject;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+@QuarkusTest
+class ApiGatewayV2RouteSelectionTest {
+
+    private static final String REGION = "us-east-1";
+    // Route storage iterates in hash order of random route IDs, so many pairs make an
+    // order-dependent selection fail almost surely instead of by chance.
+    private static final int TEMPLATES = 24;
+
+    @Inject
+    ApiGatewayV2Service apiGatewayV2Service;
+
+    @Test
+    void concreteMethodTemplateRouteWinsOverAnyForTheSameTemplate() {
+        String apiId = apiGatewayV2Service.createApi(REGION,
+                Map.of("name", "route-selection", "protocolType", "HTTP")).getApiId();
+        try {
+            Map<Integer, String> concreteRouteIds = new HashMap<>();
+            for (int i = 0; i < TEMPLATES; i++) {
+                apiGatewayV2Service.createRoute(REGION, apiId, Map.of("routeKey", "ANY /items" + i + "/{id}"));
+                Route concrete = apiGatewayV2Service.createRoute(REGION, apiId,
+                        Map.of("routeKey", "GET /items" + i + "/{id}"));
+                concreteRouteIds.put(i, concrete.getRouteId());
+            }
+
+            for (int i = 0; i < TEMPLATES; i++) {
+                assertEquals(concreteRouteIds.get(i), apiGatewayV2Service
+                        .findMatchingRoute(REGION, apiId, "GET", "/items" + i + "/abc").getRouteId());
+                assertEquals("ANY /items" + i + "/{id}", apiGatewayV2Service
+                        .findMatchingRoute(REGION, apiId, "PATCH", "/items" + i + "/abc").getRouteKey());
+            }
+        } finally {
+            apiGatewayV2Service.deleteApi(REGION, apiId);
+        }
+    }
+
+    @Test
+    void anyTemplateRouteStillMatchesWhenNoConcreteMethodExists() {
+        String apiId = apiGatewayV2Service.createApi(REGION,
+                Map.of("name", "route-selection-any", "protocolType", "HTTP")).getApiId();
+        try {
+            apiGatewayV2Service.createRoute(REGION, apiId, Map.of("routeKey", "ANY /things/{id}"));
+            apiGatewayV2Service.createRoute(REGION, apiId, Map.of("routeKey", "GET /other/{id}"));
+
+            assertEquals("ANY /things/{id}", apiGatewayV2Service
+                    .findMatchingRoute(REGION, apiId, "GET", "/things/1").getRouteKey());
+        } finally {
+            apiGatewayV2Service.deleteApi(REGION, apiId);
+        }
+    }
+}
